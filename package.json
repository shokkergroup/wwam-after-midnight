{
  "name": "wwam-after-midnight-demo",
  "version": "0.5.21",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:pages": "node scripts/build-github-pages.mjs",
    "audit:watchalong-discovery": "python scripts/discover_wwam_watchalongs.py",
    "acquire:watchalong-audio": "python scripts/acquire_wwam_watchalong_audio.py",
    "acquire:2026-livestream-audio": "python scripts/acquire_wwam_2026_livestream_audio.py",
    "generate:watchalong-canon": "node scripts/generate-wwam-watchalong-canon.mjs",
    "pilot:all-watchalong-audio": "python scripts/run_wwam_all_watchalong_audio_watch_pass.py && npm run generate:watchalong-canon",
    "pilot:2026-livestream-audio": "python scripts/run_wwam_2026_livestream_audio_watch_pass.py && npm run generate:livestream-canon",
    "pilot:halloween-audio": "python scripts/run_wwam_halloween_audio_watch_pass.py && npm run generate:watchalong-canon",
    "pilot:latest-audio": "python scripts/run_wwam_audio_watch_pass.py && npm run generate:livestream-canon",
    "generate:livestream-canon": "node scripts/generate-wwam-livestream-canon.mjs",
    "audit:public-truth": "node scripts/audit-editorial-truth.mjs --check",
    "audit:editorial-completion": "node scripts/audit-editorial-truth.mjs --require-all-human --check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
